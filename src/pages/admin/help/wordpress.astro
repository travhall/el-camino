---
// src/pages/admin/help/wordpress.astro
// In-app reference: article authoring conventions in WordPress.
import AdminLayout from "@/layouts/AdminLayout.astro";
import AccentCard from "@/components/admin/AccentCard.astro";
import AccentCardHeader from "@/components/admin/AccentCardHeader.astro";
---

<AdminLayout
  title="Writing Articles in WordPress"
  description="Category routing, event tags, and featuring products."
>
  <p class="text-(--content-body) mb-6 max-w-2xl">
    Where an article shows up on the site is decided entirely by its
    category — not where you publish it from or what it's about. Get the
    category right and everything else follows.
  </p>

  <div class="space-y-4">
    <AccentCard tone="highlight">
      <AccentCardHeader title="Categories" subtitle="Where posts appear" />
      <div class="px-4 py-4">
        <table class="w-full text-sm">
          <tbody class="divide-y divide-(--border-primary)">
            <tr><td class="py-2 pr-3 font-mono text-xs text-(--content-heading) whitespace-nowrap">shop-news</td><td class="py-2 text-(--content-body)">Shows on The Shop page.</td></tr>
            <tr><td class="py-2 pr-3 font-mono text-xs text-(--content-heading) whitespace-nowrap">news</td><td class="py-2 text-(--content-body)">Shows on the News page.</td></tr>
          </tbody>
        </table>
        <p class="mt-3 text-sm text-(--content-meta)">A post can carry both categories if it belongs in both places. There's no admin toggle for this — it's purely the category assigned in WordPress's own editor.</p>
      </div>
    </AccentCard>

    <AccentCard tone="info">
      <AccentCardHeader title="Events" subtitle="Tags" />
      <div class="px-4 py-4 text-sm text-(--content-body)">
        <p>Tag a post <strong class="text-(--content-heading)">event</strong> (in addition to its category) and it becomes filterable on the News page's event filter. Use for demos, signings, competitions — alongside <strong class="text-(--content-heading)">news</strong> so it also shows in the regular feed.</p>
      </div>
    </AccentCard>

    <AccentCard tone="neutral">
      <AccentCardHeader title="Featuring products" subtitle="Custom HTML block" />
      <div class="px-4 py-4 text-sm text-(--content-body)">
        <p>Products can be pulled live into any post — current price and stock, no manual updates. See the <a href="/admin/help/products" class="text-(--ui-accent) hover:underline">Featuring Products</a> guide: build the embed code from SKU Reference, paste it into a Custom HTML block in the post.</p>
      </div>
    </AccentCard>

    <AccentCard tone="warning">
      <AccentCardHeader title="A few things worth knowing" />
      <ul class="px-4 py-4 space-y-1.5 text-sm text-(--content-body) list-disc list-inside">
        <li><strong class="text-(--content-heading)">Featured image</strong> — set one on every post. It's what shows on article cards; posts without one look noticeably plain in a grid of ones that have it.</li>
        <li><strong class="text-(--content-heading)">Excerpt</strong> — write one if the auto-generated preview doesn't read well on its own.</li>
        <li><strong class="text-(--content-heading)">Preview before publishing</strong> — WordPress's preview doesn't show exactly how Custom HTML blocks render on the live site. Publish and check the real page if you've added one.</li>
      </ul>
    </AccentCard>
  </div>
</AdminLayout>
