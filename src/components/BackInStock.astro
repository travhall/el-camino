---
// src/components/BackInStock.astro
// Shown when a product/variant is sold out. Captures customer email and stores
// the subscription in Netlify Blobs. Tyler triggers notification emails from
// the admin Back in Stock page when the product is restocked.

interface Props {
  productId: string;
  variationId: string;
  productTitle: string;
  variationName?: string;
  hidden?: boolean;
}

const {
  productId,
  variationId,
  productTitle,
  variationName,
  hidden = false,
} = Astro.props;

import { getContactInfo } from '@/lib/contactInfo';
const contact = await getContactInfo();
const productUrl = Astro.url.href;
const label = variationName
  ? `${productTitle} — ${variationName}`
  : productTitle;
---

<section
  id="back-in-stock-section"
  aria-labelledby="bis-heading"
  data-product-title={productTitle}
  class:list={[
    'mt-6 p-4 border-2 border-(--border-secondary) rounded-sm bg-(--surface-secondary)',
    hidden && 'hidden',
  ]}
>
  <p id="bis-heading" class="text-base font-bold text-(--content-heading) mb-1">
    Get notified when it's back
  </p>
  <p class="text-sm text-(--content-body) mb-4">
    We'll reach out when <span id="bis-label-product" class="font-medium"
      >{label}</span
    > is back in stock.
  </p>

  <form
    id="back-in-stock-form"
    name="back-in-stock"
    method="POST"
    action="/api/back-in-stock"
    class="flex flex-col gap-2"
    novalidate
  >
    <input type="hidden" name="product_id" value={productId} />
    <input type="hidden" name="product_url" value={productUrl} />
    <input
      type="hidden"
      id="bis-variation-id"
      name="variation_id"
      value={variationId}
    />
    <input
      type="hidden"
      id="bis-product-title"
      name="product_title"
      value={label}
    />

    <label for="bis-email" class="text-sm font-medium text-(--content-heading)">
      Email address
    </label>
    <div class="flex flex-col sm:flex-row gap-2">
      <input
        type="email"
        name="email"
        id="bis-email"
        placeholder="name@example.com"
        required
        autocomplete="email"
        aria-describedby="bis-email-error"
        class="flex-1 h-10 px-3 text-sm border border-(--ui-input-border) rounded-sm bg-(--ui-input-surface) text-(--ui-input-text) placeholder:text-(--content-meta) focus:outline-none focus:ring-2 focus:ring-(--ui-button-ring) transition"
      />
      <button
        type="submit"
        id="bis-submit"
        class="h-10 px-4 text-sm font-semibold rounded-sm bg-(--ui-button-surface) text-(--ui-button-text) border-2 border-(--ui-button-border) hover:opacity-80 transition whitespace-nowrap cursor-pointer disabled:cursor-not-allowed disabled:opacity-60"
      >
        Notify Me
      </button>
    </div>
    <!-- Validation message for the field (filled by backInStockForm.ts) -->
    <p
      id="bis-email-error"
      class="flex items-start gap-2 text-sm text-(--content-heading) empty:hidden"
    >
    </p>
  </form>

  <!-- Persistent live region for send results: kept in the DOM and filled, since
       one that appears from display:none is announced unreliably -->
  <div
    id="bis-status"
    role="status"
    aria-live="polite"
    data-contact-email={contact.email}
    class="mt-3 flex items-start gap-2 text-sm text-(--content-heading) empty:hidden"
  >
  </div>
  <!-- Shown, and focused, on success (the form it replaces held focus) -->
  <p
    id="bis-success"
    tabindex="-1"
    class="hidden mt-3 flex items-start gap-2 text-sm font-semibold text-(--content-heading) focus:outline-none"
  >
    You're on the list! We'll email you when it's available.
  </p>
</section>

<script>
  import {
    initBackInStockForm,
    PDP_BIS_IDS,
  } from '@/lib/product/backInStockForm';

  function init() {
    initBackInStockForm(PDP_BIS_IDS);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
