---
// src/components/ArticleGrid.astro
import ArticleCard from './ArticleCard.astro';
import ArticleCardSkeleton from './ArticleCardSkeleton.astro';
import EmptyState from './EmptyState.astro';
import Sidebar from './Sidebar.astro';
import type { WordPressPost } from '@/lib/wordpress/types';

interface Props {
  posts: WordPressPost[];
  error?: string | null;
  isLoading?: boolean; // explicit only — never inferred; SSR has no async resolution
  showSidebar?: boolean; // Legacy support for home page
  filterable?: boolean; // Enables filterable news page layout
  view?: 'grid' | 'list'; // Controls grid vs list view for filterable mode
}

const {
  posts,
  error = null,
  isLoading = false,
  showSidebar = false,
  filterable = false,
  view = 'grid',
} = Astro.props;

// If sidebar is shown (home page), limit to 6 posts
const displayPosts = showSidebar ? posts.slice(0, 6) : posts;

// Loading skeleton count
const skeletonCount = showSidebar ? 6 : 12;

// Determine card variant based on layout mode
const getCardVariant = () => {
  if (filterable) {
    return view; // "grid" or "list"
  }
  return 'masonry'; // Home page masonry layout
};

// OPTIMIZATION: Conservative priority loading
// Home page: first image only (LCP critical)
// News grid: first 2 images (reduce eager loading for mobile)
// News list: first image only (large cards)
// Plan 230: cards in the first viewport must not start at a true `opacity: 0`.
// Chrome ignores such an element as an LCP candidate, so LCP waited for the
// script that reveals the cards (2.0 s of /news's 4.1 s on throttled mobile).
// They use the home page's mechanism instead (`news-entrance`): a CSS animation
// whose `from` keyframe is opacity 0.001 (fade only, no scale), armed by the
// inline script below once the card's image has loaded, with the same 2.5 s
// safety net. Grid: the first two rows of the 2-column mobile layout (and the
// first row of 3-6 columns). List: one card is above the fold on mobile, two
// cover tablets.
// Later cards keep the scroll-in reveal below.
const initiallyVisibleCount = view === 'list' ? 2 : 4;

const shouldPrioritize = (index: number) => {
  if (!filterable) return index < 2; // Home page: first two (second card is actual LCP on mobile)
  return view === 'grid' ? index < 2 : index === 0; // News - more conservative
};

// Get container classes based on layout mode
const getContainerClasses = () => {
  if (filterable) {
    if (view === 'list') {
      return 'flex flex-col gap-1';
    } else {
      // Grid view for news page - matches product category grid pattern
      return 'grid xs:grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-6 gap-1';
    }
  }
  // Original masonry layout for home page
  // grid-cols-1 (mobile base): without an explicit column track, the single
  // implicit column defaults to content-based (fit-content) sizing instead of
  // stretching to the container. That column width is shared by every
  // col-span-full card, so it's intrinsically sized by whichever card's
  // content has the largest max-content contribution — before the featured
  // (LCP) image finishes decoding, that's small; once the image's real
  // natural width becomes available, the column snaps to full width,
  // shifting every card sharing it (CLS 0.407). grid-cols-1 uses `1fr`,
  // which always takes 100% of available space regardless of content,
  // eliminating the race. Confirmed via trace: shift fires ~7ms after the
  // featured image's network responseEnd, ~590ms after fonts are already
  // ready (ruling out font-swap). See plans/archive/123-fix-homepage-masonry-cls.md.
  return 'article-grid grid grid-cols-1 justify-center md:grid-cols-6 3xl:grid-cols-8 md:auto-rows-auto md:auto-rows-[12vw] lg:auto-rows-[10vw] xl:auto-rows-[9vw] 3xl:auto-rows-[9.5vw] w-full gap-1 p-1 pb-0';
};

// Get skeleton variant for loading states
const getSkeletonVariant = () => {
  if (filterable && view === 'list') {
    return 'list';
  } else if (filterable && view === 'grid') {
    return 'grid';
  }
  return 'masonry';
};

const currentPath = Astro.url.pathname;
const nonce = Astro.locals.nonce;
---

{
  error && (
    <div class="text-state-error-text bg-state-error-surface p-4 rounded flex flex-col items-start gap-3">
      <p>{error}</p>
      <div class="flex flex-wrap gap-4">
        <a href={currentPath} class="loading-retry-button">
          Try again
        </a>
        <a href="/shop/all" class="underline font-semibold">
          Browse the shop instead
        </a>
      </div>
    </div>
  )
}

<div
  class={getContainerClasses()}
  id={filterable ? 'filterable-article-grid' : undefined}
  role={filterable ? 'feed' : undefined}
  aria-label={filterable ? 'Article listings' : undefined}
  aria-busy="false"
>
  {
    isLoading ? (
      Array(skeletonCount)
        .fill(null)
        .map((_, i) => (
          <ArticleCardSkeleton
            featured={!filterable && i === 0}
            variant={getSkeletonVariant()}
          />
        ))
    ) : displayPosts.length > 0 ? (
      <>
        {displayPosts.map((post, index) => {
          // Pass animation data attributes to all cards
          if (filterable) {
            return (
              <div
                class={`article-card-wrapper ${index < initiallyVisibleCount ? 'news-entrance' : 'opacity-0'} w-full max-w-full`}
                style={
                  index < initiallyVisibleCount
                    ? `--animation-order: ${index};`
                    : undefined
                }
                role="article"
                data-initial-index={index}
                data-variant={getCardVariant()}
              >
                <ArticleCard
                  post={post}
                  featured={false}
                  priority={shouldPrioritize(index)}
                  variant={getCardVariant()}
                />
              </div>
            );
          } else {
            // Home page - pass animation props directly to ArticleCard
            return (
              <ArticleCard
                post={post}
                featured={index === 0}
                priority={shouldPrioritize(index)}
                variant={getCardVariant()}
                data-initial-index={index}
                data-variant={getCardVariant()}
                style={`--animation-order: ${index};`}
              />
            );
          }
        })}

        {/* Home page sidebar and CTA (only for non-filterable mode) */}
        {showSidebar && !filterable && (
          <>
            <Sidebar />
            <div class="bg-(--surface-secondary) col-span-full lg:col-span-4 3xl:col-span-6 3xl:row-span-2 p-8 place-content-center hidden lg:flex flex-col -mt-1 md:mt-0 lg:flex-row gap-4 lg:justify-between lg:items-center" />
          </>
        )}
      </>
    ) : !error ? (
      <EmptyState
        class="col-span-full"
        emoji="🛹"
        heading={showSidebar ? 'Nothing new on the wall yet' : 'No posts found'}
        body={
          showSidebar
            ? "Fresh news and shop updates land here. In the meantime, the shop's open."
            : undefined
        }
        ctaLabel={showSidebar ? 'Shop All' : undefined}
        ctaHref={showSidebar ? '/shop/all' : undefined}
      />
    ) : null
  }
</div>

<script is:inline nonce={nonce}>
  // Belt-and-braces safety net (plan 148): if the hoisted script above fails
  // to run or load (bundling error, CSP issue), this unconditionally arms
  // every masonry card after 2500ms so the homepage can never stay blank.
  setTimeout(() => {
    document
      .querySelectorAll(
        '.article-grid .article-card-wrapper, .article-card-wrapper.news-entrance'
      )
      .forEach((wrapper) => wrapper.classList.add('entrance-armed'));
  }, 2500);

  // News grid, first viewport (plan 230): arm each card the moment its own image
  // has loaded. This must be inline. armCardsOnImageReady (the hoisted module
  // script) runs only after the page's ~39 script requests; measured on
  // throttled mobile the cards then fell back to the 2.5 s timer above and
  // appeared as late as before the fix (Speed Index 3.5 s). Inline, the card
  // fades in as soon as its image paints.
  document
    .querySelectorAll('.article-card-wrapper.news-entrance')
    .forEach((wrapper) => {
      const arm = () => wrapper.classList.add('entrance-armed');
      const img = wrapper.querySelector('img');
      if (!img || img.complete) {
        arm();
        return;
      }
      img.addEventListener('load', arm, { once: true });
      img.addEventListener('error', arm, { once: true });
    });
</script>

<style is:global>
  /* ─── Keyframes ─────────────────────────────────────────────────────────── */

  /* Non-featured masonry cards: simultaneous opacity + transform entrance.
     opacity:0.001 (not 0) is intentional: Chrome's LCP algorithm excludes
     elements with opacity:0 from candidacy. With animation-fill-mode:both,
     the `from` keyframe is applied before the animation starts, meaning a
     true opacity:0 gives Lighthouse nothing to track → NO_LCP error.
     0.001 is perceptually invisible but registers as a valid LCP candidate.
     CSS transform is composited — it does not affect layout position and
     cannot cause CLS regardless of opacity. */
  @keyframes cardEntrance {
    from {
      opacity: 0.001;
      transform: scale(0.95) translate3d(0, 10px, 0);
    }
    to {
      opacity: 1;
      transform: scale(1) translate3d(0, 0, 0);
    }
  }

  /* Featured (LCP) card: single-phase entrance — opacity and transform animate
     simultaneously, matching production's visual quality.
     opacity:0.001 (not 0) ensures Chrome registers this as an LCP candidate
     from the very first paint. CSS transform is composited and cannot cause CLS. */
  @keyframes cardEntranceFeatured {
    from {
      opacity: 0.001;
      transform: scale(0.95) translate3d(0, 10px, 0);
    }
    to {
      opacity: 1;
      transform: scale(1) translate3d(0, 0, 0);
    }
  }

  /* News grid, first viewport (plan 230): opacity only. The masonry keyframes
     above also scale to 0.95, which shrinks the card's painted area; measured on
     a deploy preview, a later full-size card then replaced it as the LCP element
     (3.6 s, against 2.25 s). Opacity from 0.001 still makes the card an LCP
     candidate from first paint and leaves its area intact. */
  @keyframes newsCardEntrance {
    from {
      opacity: 0.001;
    }
    to {
      opacity: 1;
    }
  }

  /* ─── Base wrapper (shared by masonry + filterable grid) ─────────────────── */

  .article-card-wrapper {
    transform: translate3d(0, 0, 0); /* GPU compositing layer */
    max-width: 100%;
    width: 100%;
    min-width: 0;
  }

  /* ─── Filterable grid (news page) — JS/transition-driven, unchanged ──────── */

  .article-card-wrapper.opacity-0 {
    opacity: 0;
    transform: scale(0.95) translate3d(0, 10px, 0);
    transition:
      opacity var(--card-transition-duration) ease,
      transform var(--card-transition-duration) ease;
    transition-delay: 0s, 0s;
  }

  .article-card-wrapper.opacity-100 {
    opacity: 1;
    transform: scale(1) translate3d(0, 0, 0);
    transition:
      opacity var(--card-transition-duration) ease,
      transform var(--card-transition-duration) ease;
    transition-delay:
      calc(var(--animation-order, 0) * var(--card-stagger-delay)),
      calc(var(--animation-order, 0) * var(--card-stagger-delay));
  }

  .article-card-wrapper.animating {
    will-change: opacity, transform;
  }

  .article-card-wrapper:not(.animating) {
    will-change: auto;
  }

  /* ─── Masonry grid (home page) — CSS-driven, fires at parse time ─────────── */

  /* Non-featured cards: staggered entrance. The animation is paused (see
     entrance-armed below) until each card's own image is ready, so the
     stagger is now provided by network arrival order rather than a fixed
     200ms header-lead offset — that offset was removed since it no longer
     applies once each card starts on its own image's readiness (plan 148). */
  .article-grid .article-card-wrapper {
    animation: cardEntrance var(--card-transition-duration, 0.5s) ease-out both;
    animation-delay: calc(
      var(--animation-order, 0) * var(--card-stagger-delay)
    );
    animation-play-state: paused;
  }

  /* Featured card: starts immediately — LCP-critical, no offset applied */
  .article-grid .article-card-wrapper.card-entrance-ready {
    animation: cardEntranceFeatured
      var(--card-entrance-priority-duration, 800ms) ease-out both;
    animation-delay: 0s;
    animation-play-state: paused;
  }

  /* The entrance animation is paused until JS marks the card armed (its image
     is ready, or a bounded timeout elapsed). A CSS animation's clock otherwise
     starts at first style resolution, so on a cold load the cards animated in
     empty and the images popped in afterwards. `both` fill-mode holds the
     `from` keyframe while paused, so a paused card is invisible-but-LCP-eligible
     (opacity 0.001), exactly as before. */
  .article-grid .article-card-wrapper.entrance-armed {
    animation-play-state: running;
  }

  /* News grid, first viewport only (plan 230): the masonry's mechanism (paused at
     opacity 0.001, armed when the card's image is ready) with an opacity-only
     fade, so the card is an LCP candidate from first paint. The remaining news cards use the
     .opacity-0 scroll-in reveal above. */
  .article-card-wrapper.news-entrance {
    /* `backwards`, not `both`: holds the 0.001 `from` keyframe until the card is
       armed, but leaves no fill once it ends. A forwards fill would pin
       opacity 1 and override the `.opacity-0` class the filter exit adds to
       fade every card out (filterCoordinator). */
    animation: newsCardEntrance var(--card-transition-duration, 0.5s) ease-out
      backwards;
    animation-delay: calc(
      var(--animation-order, 0) * var(--card-stagger-delay)
    );
    animation-play-state: paused;
  }

  .article-card-wrapper.news-entrance.entrance-armed {
    animation-play-state: running;
  }

  /* If JS never arms the cards (script error, JS disabled), reveal them.
     Without this, a paused `both`-filled animation would hold opacity 0.001
     forever and the page would look empty. */
  @media (scripting: none) {
    .article-grid .article-card-wrapper,
    .article-card-wrapper.news-entrance {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-grid .article-card-wrapper,
    .article-grid .article-card-wrapper.card-entrance-ready,
    .article-card-wrapper.news-entrance {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<style>
  /* List view specific styles */
  .flex.flex-col.gap-1 .group:hover {
    transform: translateX(4px);
  }

  /* Grid view specific styles */
  .grid.gap-1 .group:hover {
    transform: translateY(-4px);
  }

  /* Masonry layout styles (preserved from original) */
  .article-grid .group:hover {
    z-index: 10;
  }
</style>

<script>
  import { init } from '@/scripts/article-grid-client';

  init();
</script>
