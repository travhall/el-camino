---
// src/components/AppliedFilters.astro
import { fetchCategoryHierarchy } from "@/lib/square/categories";
import type { FilterOptions, ProductFilters, CategoryFilterOption } from "@/lib/square/types";

export interface Props {
  classes?: string;
  filterOptions?: FilterOptions;
  appliedFilters?: ProductFilters;
  categoryPath?: string;
}

const { classes, filterOptions, appliedFilters, categoryPath = "" } = Astro.props;

// Parse current filters from URL
const currentParams = new URLSearchParams(Astro.url.search);
const currentBrands = appliedFilters?.brands || currentParams.getAll("brands") || [];
const currentCategories = appliedFilters?.categories || currentParams.getAll("categories") || [];
const currentAvailability = appliedFilters?.availability ?? (currentParams.get("availability") === "true");
const currentOnSale = appliedFilters?.onSale ?? (currentParams.get("onSale") === "true");

const hasActiveFilters = currentBrands.length > 0 || currentCategories.length > 0 || currentAvailability || currentOnSale;

// Build comprehensive slug→name and id→name maps for category pill display.
// We always populate from filterOptions (fast, already in memory) so that
// data-category-names is never empty — even when no filters are active on
// initial load. Without this, client-side filter changes would fall back to
// raw slugs ("bearings-bolts-more") instead of proper names.
let categorySlugNameMap: Map<string, string> = new Map();
let categoryIdNameMap: Map<string, string> = new Map();

// Always seed from filterOptions first (no extra fetch needed)
if (filterOptions?.categories) {
  for (const cat of filterOptions.categories) {
    if (cat.slug) categorySlugNameMap.set(cat.slug, cat.name);
    if (cat.id) categoryIdNameMap.set(cat.id, cat.name);
    for (const sub of cat.subcategories || []) {
      if (sub.slug) categorySlugNameMap.set(sub.slug, sub.name);
      if (sub.id) categoryIdNameMap.set(sub.id, sub.name);
    }
  }
}

// Also fetch the full hierarchy when categories are active, to cover any
// slugs that aren't present in filterOptions (e.g. on /shop/sale subset pages).
if (currentCategories.length > 0) {
  try {
    const hierarchy = await fetchCategoryHierarchy();
    for (const { category, subcategories } of hierarchy) {
      categorySlugNameMap.set(category.slug, category.name);
      categoryIdNameMap.set(category.id, category.name);
      for (const sub of subcategories) {
        categorySlugNameMap.set(sub.slug, sub.name);
        categoryIdNameMap.set(sub.id, sub.name);
      }
    }
  } catch {
    // getCategoryName will fall back to filterOptions
  }
}

function getCategoryName(slugOrId: string, categories: CategoryFilterOption[] = []): string {
  // Check filterOptions first (fastest, already in memory)
  for (const cat of categories) {
    if (cat.slug === slugOrId || cat.id === slugOrId) return cat.name;
    const sub = cat.subcategories.find((s) => s.slug === slugOrId || s.id === slugOrId);
    if (sub) return sub.name;
  }
  // Fallback to hierarchy maps (handles slugs not present in filtered filterOptions)
  return categorySlugNameMap.get(slugOrId) ?? categoryIdNameMap.get(slugOrId) ?? slugOrId;
}
---

<style>
  .applied-filters-container {
    margin-bottom: 0.5rem;
    /* Transition is controlled by JavaScript - not CSS */
    /* This prevents unwanted animations on every filter change */
  }

  .applied-filters-container.no-filters {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* Prevent View Transition from animating AppliedFilters during filter changes */
  /* This allows JavaScript to have full control over animation timing */
  @media (prefers-reduced-motion: no-preference) {
    html::view-transition-group(applied-filters) {
      animation-duration: 0s; /* Instant bounding-box snap — prevents height animation from clipping pills mid-transition */
    }
    html::view-transition-old(applied-filters) {
      animation: none;
      opacity: 0; /* Suppress captured old state — prevents double-image overlap during filter changes */
    }
    html::view-transition-new(applied-filters) {
      animation: none; /* New state shown immediately; JS manages entrance animation */
    }
  }

  /* Thin scrollbar for the horizontal chip row below the lg: breakpoint */
  .applied-filters-scroll::-webkit-scrollbar {
    height: 3px;
  }

  .applied-filters-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .applied-filters-scroll::-webkit-scrollbar-thumb {
    background-color: var(--border-tertiary);
    border-radius: 3px;
  }
</style>

<div
  id="applied-filters-container"
  tabindex="-1"
  class:list={[
    "applied-filters-container px-2",
    classes,
    !hasActiveFilters ? "no-filters" : "",
  ]}
  style="view-transition-name: applied-filters;"
  data-category-names={JSON.stringify(Object.fromEntries(categorySlugNameMap))}
  data-category-path={categoryPath}
>
  <div
    id="applied-filters-row"
    class="applied-filters-scroll flex flex-nowrap lg:flex-wrap items-center gap-2 lg:gap-3 my-2 overflow-x-auto lg:overflow-visible"
  >
    {
      hasActiveFilters && (
        <>
          {currentBrands.map((brand) => (
            <span class="shrink-0 inline-flex items-center gap-0.5 pl-3 pr-1 py-1.5 text-sm border rounded-full bg-(--surface-primary) text-(--ui-input-text) border-(--ui-input-border)/50">
              <span>{brand}</span>
              <button
                type="button"
                data-remove-brand={brand}
                aria-label={`Remove ${brand} filter`}
                title={`Remove ${brand} filter`}
                class="inline-flex items-center justify-center rounded-full p-2.5 -m-1 text-(--content-meta) hover:text-(--content-body) hover:bg-(--surface-tertiary) transition-colors"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
              </button>
            </span>
          ))}
          {currentCategories.map((categoryId) => {
            const name = getCategoryName(categoryId, filterOptions?.categories || []);
            return (
              <span class="shrink-0 inline-flex items-center gap-0.5 pl-3 pr-1 py-1.5 text-sm border rounded-full bg-(--surface-primary) text-(--ui-input-text) border-(--ui-input-border)/50">
                <span>{name}</span>
                <button
                  type="button"
                  data-filter-type="categories"
                  data-filter-value={categoryId}
                  aria-label={`Remove ${name} filter`}
                  title={`Remove ${name} filter`}
                  class="inline-flex items-center justify-center rounded-full p-2.5 -m-1 text-(--content-meta) hover:text-(--content-body) hover:bg-(--surface-tertiary) transition-colors"
                >
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M6 18L18 6M6 6l12 12"
                    />
                  </svg>
                </button>
              </span>
            );
          })}
          {currentAvailability && (
            <span class="shrink-0 inline-flex items-center gap-0.5 pl-3 pr-1 py-1.5 text-sm border rounded-full bg-(--surface-primary) text-(--ui-input-text) border-(--ui-input-border)/50">
              <span>In stock only</span>
              <button
                type="button"
                data-remove-availability
                aria-label="Remove in stock only filter"
                title="Remove in stock only filter"
                class="inline-flex items-center justify-center rounded-full p-2.5 -m-1 text-(--state-success-text)/70 hover:text-(--state-success-text) hover:bg-(--surface-tertiary) transition-colors"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
              </button>
            </span>
          )}
          {currentOnSale && (
            <span class="shrink-0 inline-flex items-center gap-0.5 pl-3 pr-1 py-1.5 text-sm border rounded-full bg-(--surface-primary) text-(--ui-input-text) border-(--ui-input-border)/50">
              <span>On sale only</span>
              <button
                type="button"
                data-remove-on-sale
                aria-label="Remove on sale only filter"
                title="Remove on sale only filter"
                class="inline-flex items-center justify-center rounded-full p-2.5 -m-1 text-(--content-meta) hover:text-(--content-body) hover:bg-(--surface-tertiary) transition-colors"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
              </button>
            </span>
          )}
          <button
            type="button"
            data-clear-all-filters
            class="shrink-0 text-sm text-(--content-meta) hover:text-(--content-emphasis) transition-colors text-nowrap"
          >
            Clear All
          </button>
        </>
      )
    }
  </div>
  <div id="applied-filters-live-region" aria-live="polite" aria-atomic="true" class="sr-only" />
</div>

<script>
  import { FilterCoordinator } from "@/lib/filterCoordinator";

  FilterCoordinator.initialize();

  // ── Pill rendering ──────────────────────────────────────────────────────────

  const PILL_WRAP_CLASS =
    "shrink-0 inline-flex items-center gap-0.5 pl-3 pr-1 py-1.5 text-sm border rounded-full bg-(--surface-primary) text-(--ui-input-text) border-(--ui-input-border)/50";

  const REMOVE_BTN_CLASS =
    "inline-flex items-center justify-center rounded-full p-2.5 -m-1 text-(--content-meta) hover:text-(--content-body) hover:bg-(--surface-tertiary) transition-colors";

  const REMOVE_BTN_CLASS_GREEN =
    "inline-flex items-center justify-center rounded-full p-2.5 -m-1 text-(--state-success-text)/70 hover:text-(--state-success-text) hover:bg-(--surface-tertiary) transition-colors";

  const X_ICON = `<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>`;

  function buildPill(
    label: string,
    removeBtnClass: string,
    ariaLabel: string,
    configureBtn: (btn: HTMLButtonElement) => void,
  ): HTMLElement {
    const wrap = document.createElement("span");
    wrap.className = PILL_WRAP_CLASS;

    const labelSpan = document.createElement("span");
    labelSpan.textContent = label;
    wrap.appendChild(labelSpan);

    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = removeBtnClass;
    btn.setAttribute("aria-label", ariaLabel);
    btn.title = ariaLabel;
    btn.insertAdjacentHTML("beforeend", X_ICON);
    configureBtn(btn);
    wrap.appendChild(btn);

    return wrap;
  }

  function appendPills(
    row: HTMLElement,
    brands: string[],
    categories: string[],
    availability: boolean,
    categoryNames: Record<string, string>,
    onSale: boolean,
  ) {
    brands.forEach((brand) => {
      row.appendChild(
        buildPill(brand, REMOVE_BTN_CLASS, `Remove ${brand} filter`, (btn) => {
          btn.dataset.removeBrand = brand;
        }),
      );
    });

    categories.forEach((slug) => {
      const name = categoryNames[slug] || slug;
      row.appendChild(
        buildPill(name, REMOVE_BTN_CLASS, `Remove ${name} filter`, (btn) => {
          btn.dataset.filterType = "categories";
          btn.dataset.filterValue = slug;
        }),
      );
    });

    if (availability) {
      row.appendChild(
        buildPill("In stock only", REMOVE_BTN_CLASS_GREEN, "Remove in stock only filter", (btn) => {
          btn.dataset.removeAvailability = "";
        }),
      );
    }

    if (onSale) {
      row.appendChild(
        buildPill("On sale only", REMOVE_BTN_CLASS, "Remove on sale only filter", (btn) => {
          btn.dataset.removeOnSale = "";
        }),
      );
    }
  }

  // ── Focus + announcement bookkeeping ─────────────────────────────────────────
  // Set right before a chip-driven filter change is dispatched (click handlers
  // below), then consumed once at the tail of updateAppliedFilters. Stays null
  // for filter changes that originate elsewhere (e.g. the desktop sidebar),
  // so this component doesn't steal focus for changes it didn't cause.

  let pendingFocusIndex: number | null = null;
  let pendingRemovedLabel: string | null = null;

  function getRemoveButtons(): HTMLElement[] {
    const row = document.getElementById("applied-filters-row");
    if (!row) return [];
    return Array.from(
      row.querySelectorAll<HTMLElement>(
        "[data-remove-brand], [data-filter-type='categories'], [data-remove-availability], [data-remove-on-sale]"
      )
    );
  }

  function focusFallback(container: HTMLElement) {
    // Last chip removed — the container is about to be hidden, so move focus
    // to the page heading rather than an element that's leaving the a11y tree.
    const heading = document.querySelector("h1") as HTMLElement | null;
    if (heading) {
      if (!heading.hasAttribute("tabindex")) heading.setAttribute("tabindex", "-1");
      heading.focus();
    } else {
      container.focus();
    }
  }

  function announceRemoval() {
    if (!pendingRemovedLabel) return;
    const region = document.getElementById("applied-filters-live-region");
    if (region) {
      region.textContent = "";
      const label = pendingRemovedLabel;
      window.setTimeout(() => {
        region.textContent = `${label} filter removed`;
      }, 50);
    }
    pendingRemovedLabel = null;
  }

  function updateAppliedFilters(
    brands: string[],
    categories: string[],
    availability: boolean,
    onSale: boolean = false,
  ) {
    const container = document.getElementById("applied-filters-container");
    const row = document.getElementById("applied-filters-row");
    if (!container || !row) return;

    const hasActive = brands.length > 0 || categories.length > 0 || availability || onSale;

    if (!hasActive) {
      // Focus while still visible — a hidden/removed element can't take focus.
      if (pendingFocusIndex !== null) focusFallback(container);
      container.classList.add("no-filters");
      row.innerHTML = "";
      pendingFocusIndex = null;
      announceRemoval();
      return;
    }

    container.classList.remove("no-filters");

    const categoryNames = JSON.parse(
      container.dataset.categoryNames || "{}"
    ) as Record<string, string>;

    row.innerHTML = "";
    appendPills(row, brands, categories, availability, categoryNames, onSale);

    const clearAllBtn = document.createElement("button");
    clearAllBtn.type = "button";
    clearAllBtn.dataset.clearAllFilters = "";
    clearAllBtn.className =
      "shrink-0 text-sm text-(--content-meta) hover:text-(--content-emphasis) transition-colors text-nowrap";
    clearAllBtn.textContent = "Clear All";
    row.appendChild(clearAllBtn);

    setupFilterHandlers();

    if (pendingFocusIndex !== null) {
      const buttons = getRemoveButtons();
      if (buttons.length === 0) {
        focusFallback(container);
      } else {
        buttons[Math.min(pendingFocusIndex, buttons.length - 1)]?.focus();
      }
      pendingFocusIndex = null;
    }
    announceRemoval();
  }

  // ── Filter state manipulation ────────────────────────────────────────────────

  function dispatchFilterChange(
    brands: string[],
    categories: string[],
    availability: boolean,
    onSale: boolean = false,
  ) {
    const params = new URLSearchParams();
    brands.forEach((b) => params.append("brands", b));
    categories.forEach((c) => params.append("categories", c));
    if (availability) params.set("availability", "true");
    if (onSale) params.set("onSale", "true");
    const qs = params.toString();
    history.pushState({}, "", `${window.location.pathname}${qs ? "?" + qs : ""}`);
    window.dispatchEvent(
      new CustomEvent("filterchange", { detail: { brands, categories, availability, onSale } })
    );
  }

  function removeFilter(type: string, value: string | null = null) {
    const p = new URLSearchParams(window.location.search);
    const brands = p.getAll("brands");
    const cats = p.getAll("categories");
    const avail = p.get("availability") === "true";
    const sale = p.get("onSale") === "true";

    if (type === "brand" && value) {
      dispatchFilterChange(brands.filter((b) => b !== value), cats, avail, sale);
    } else if (type === "categories" && value) {
      dispatchFilterChange(brands, cats.filter((c) => c !== value), avail, sale);
    } else if (type === "availability") {
      dispatchFilterChange(brands, cats, false, sale);
    } else if (type === "onSale") {
      dispatchFilterChange(brands, cats, avail, false);
    }
  }

  // ── Event handler setup ──────────────────────────────────────────────────────

  function setupFilterHandlers() {
    document.querySelectorAll<HTMLElement>("[data-remove-brand]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const brand = target.dataset.removeBrand;
        if (brand) {
          pendingFocusIndex = getRemoveButtons().indexOf(target);
          pendingRemovedLabel = brand;
          removeFilter("brand", brand);
        }
      });
    });

    document.querySelectorAll<HTMLElement>("[data-filter-type='categories']").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const slug = target.dataset.filterValue;
        if (slug) {
          pendingFocusIndex = getRemoveButtons().indexOf(target);
          pendingRemovedLabel = target.getAttribute("aria-label")?.replace(/^Remove /, "").replace(/ filter$/, "") ?? slug;
          removeFilter("categories", slug);
        }
      });
    });

    document.querySelector<HTMLElement>("[data-remove-availability]")?.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLElement;
      pendingFocusIndex = getRemoveButtons().indexOf(target);
      pendingRemovedLabel = "In stock only";
      removeFilter("availability");
    });

    document.querySelector<HTMLElement>("[data-remove-on-sale]")?.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLElement;
      pendingFocusIndex = getRemoveButtons().indexOf(target);
      pendingRemovedLabel = "On sale only";
      removeFilter("onSale");
    });

    document.querySelector("[data-clear-all-filters]")?.addEventListener("click", () => {
      pendingFocusIndex = 0;
      pendingRemovedLabel = "All";
      dispatchFilterChange([], [], false, false);
    });
  }

  // ── Module-level listeners ───────────────────────────────────────────────────

  window.addEventListener("filterchange", (e: Event) => {
    const evt = e as CustomEvent<{
      brands: string[];
      categories: string[];
      availability: boolean;
      onSale?: boolean;
    }>;
    updateAppliedFilters(evt.detail.brands, evt.detail.categories, evt.detail.availability, evt.detail.onSale ?? false);
  });

  document.addEventListener("astro:page-load", () => {
    setupFilterHandlers();
  });
</script>
