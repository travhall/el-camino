# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# This file is the single source of truth for required/optional configuration.
# Adding a new `import.meta.env.X` / `process.env.X` read in `src/` should add
# a line here in the same change.
#
# PUBLIC_-prefixed variables are exposed to client-side code by Astro/Vite —
# do not put secrets in a PUBLIC_ variable.

# --- Square (required) ---
# Server-side Square API access token. Required — the app throws at first
# Square API use if this is missing (src/lib/square/squareInstance.ts).
SQUARE_ACCESS_TOKEN=your-square-access-token-here

# Square location ID for this shop. Required (PUBLIC_ — reaches the client).
PUBLIC_SQUARE_LOCATION_ID=your-square-location-id-here

# --- Square (optional) ---
# "production" or "sandbox". Defaults to sandbox if unset. PUBLIC_ — reaches
# the client (used for a Square environment indicator).
PUBLIC_SQUARE_ENVIRONMENT=sandbox

# Signature key from the Square Developer Dashboard webhook subscription.
# Optional — if unset, the webhook endpoint logs an error and returns 200
# without processing (src/pages/api/webhooks/square.ts).
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key-here

# Square Application ID. Declared in src/env.d.ts and stubbed in CI, but no
# code currently reads it — likely reserved for a future client-side Square
# Web Payments SDK integration. Safe to leave as a placeholder.
PUBLIC_SQUARE_APP_ID=your-square-app-id-here

# Square API retry/circuit-breaker tuning (src/lib/square/apiRetry.ts). All
# optional — each falls back to a built-in default if unset or non-numeric.
SQUARE_MAX_RETRIES=3
SQUARE_BASE_DELAY=500
SQUARE_MAX_DELAY=5000
SQUARE_JITTER_RANGE=0.1
SQUARE_TIMEOUT_MS=10000
SQUARE_CIRCUIT_THRESHOLD=5
SQUARE_RECOVERY_TIMEOUT=30000
SQUARE_MONITOR_WINDOW=60000

# --- Email (Resend) (required for order/notification emails) ---
# src/lib/email/sender.ts throws if these are unset when an email is sent.
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=orders@example.com
# Internal address that receives pickup/back-in-stock notifications.
TYLER_EMAIL=notify@example.com

# --- Admin (required to use /admin/*) ---
# Password for the admin login form (src/pages/api/admin-auth.ts).
ADMIN_PASSWORD=changeme
# Long random string used to HMAC-sign the admin session cookie. Generate
# your own — do not reuse this placeholder.
ADMIN_SECRET=changeme-generate-a-long-random-string

# --- WordPress (optional) ---
# Base URL of the headless WordPress REST API. Defaults to
# https://api.elcaminoskateshop.com/wp-json/wp/v2 if unset. PUBLIC_ — reaches
# the client.
PUBLIC_WORDPRESS_API_URL=

# --- Misc (optional) ---
# Chrome UX Report API key, used by the admin performance dashboard
# (src/pages/api/crux-data.ts) for real field data. Degrades to "no_key"
# status without it.
CRUX_API_KEY=your-crux-api-key-here

# Shared secret checked by /api/warmup (src/pages/api/warmup.ts), pinged by
# .github/workflows/keep-warm.yml to keep serverless functions warm. Optional
# — without it, the endpoint just returns 401.
WARMUP_SECRET=changeme-generate-a-random-string

# Set to "development" to bypass Netlify Blobs and use the in-memory fallback
# cache locally (src/lib/cache/blobCache.ts). Optional — normally left unset.
ASTRO_NODE_ENV=
